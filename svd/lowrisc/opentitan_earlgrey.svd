						<field>
							<name>TSU_STO</name>
							<description>Actual setup time for stop signals</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>T_BUF</name>
							<description>Actual time between each STOP signal and the following START signal</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
