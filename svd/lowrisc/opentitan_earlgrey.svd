							<bitRange>[4:2]</bitRange>
							<enumeratedValues>
								<enumeratedValue>
									<name>rxlvl1</name>
									<description>1 character</description>
									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl4</name>
									<description>4 characters</description>
									<value>1</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl8</name>
									<description>8 characters</description>
									<value>2</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl16</name>
									<description>16 characters</description>
									<value>3</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl30</name>
									<description>30 characters</description>
									<value>4</value>
								</enumeratedValue>
							</enumeratedValues>
						</field>
						<field>
							<name>TXILVL</name>
							<description>Trigger level for TX interrupts. If the FIFO depth is less than the setting, itraises tx_watermark interrupt.</description>
							<bitRange>[6:5]</bitRange>
							<enumeratedValues>
								<enumeratedValue>
									<name>txlvl1</name>
									<description>2 characters</description>
									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>txlvl4</name>
									<description>4 characters</description>
									<value>1</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>txlvl8</name>
									<description>8 characters</description>
									<value>2</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>txlvl16</name>
									<description>16 characters</description>
									<value>3</value>
								</enumeratedValue>
							</enumeratedValues>
						</field>
					</fields>
				</register>
				<register>
					<name>FIFO_STATUS</name>
					<description>UART FIFO status register</description>
					<addressOffset>0xa0</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name>TXLVL</name>
							<description>Current fill level of TX fifo</description>
							<bitRange>[5:0]</bitRange>
						</field>
						<field>
							<name>RXLVL</name>
							<description>Current fill level of RX fifo</description>
							<bitRange>[21:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>OVRD</name>
