							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>SDAVAL</name>
							<description>Value for SDA Override. Set to 0 to drive TX Low, and set to 1 for high-Z</description>
							<bitRange>[2]</bitRange>
						</field>
