						<field>
							<name>VAL</name>
							<description>RX timeout value in UART bit times</description>
							<bitRange>[23:0]</bitRange>
						</field>
						<field>
							<name>EN</name>
							<description>Enable RX timeout feature</description>
							<bitRange>[31]</bitRange>
						</field>
					</fields>
				</register>			</registers>		</peripheral>
