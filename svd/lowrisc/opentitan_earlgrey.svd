					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>TXEN</name>
							<description>Enable TX pin override control</description>
							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>TXVAL</name>
							<description>Write to set the value of the TX pin</description>
							<bitRange>[1]</bitRange>
						</field>
					</fields>
