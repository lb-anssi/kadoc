							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>RXFULL</name>
							<description>RX buffer is full</description>
							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>TXEMPTY</name>
							<description>TX FIFO is empty</description>
							<bitRange>[2]</bitRange>
						</field>
						<field>
							<name>TXIDLE</name>
							<description>TX FIFO is empty and all bits have been transmitted</description>
							<bitRange>[3]</bitRange>
						</field>
						<field>
							<name>RXIDLE</name>
							<description>RX is idle</description>
							<bitRange>[4]</bitRange>
						</field>
						<field>
							<name>RXEMPTY</name>
							<description>RX FIFO is empty</description>
							<bitRange>[5]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>RDATA</name>
					<description>UART read data</description>
					<addressOffset>0x40</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[7:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>WDATA</name>
					<description>UART write data</description>
					<addressOffset>0x60</addressOffset>
					<size>32</size>
					<access>wo</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[7:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>FIFO_CTRL</name>
					<description>UART FIFO control register</description>
					<addressOffset>0x80</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>RXRST</name>
