					</fields>
				</register>
				<register>
					<name>TIMEOUT_CTRL</name>
					<description>UART RX timeout control</description>
					<addressOffset>0x100</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>VAL</name>
							<description>RX timeout value in UART bit times</description>
							<bitRange>[23:0]</bitRange>
						</field>
						<field>
							<name>EN</name>
							<description>Enable RX timeout feature</description>
							<bitRange>[31]</bitRange>
						</field>
					</fields>
				</register>			</registers>		</peripheral>
		<peripheral>
			<name>gpio</name>
			<description>General-purpose I/O pin control interface for software</description>
			<baseAddress>0x40040000</baseAddress>
			<size>32</size>
			<addressBlock>
				<offset>0x40040000</offset>
				<size>384</size>
				<usage>registers</usage>
			</addressBlock>
			<interrupt>
				<name>gpio</name>
				<description>raised if any of GPIO pin detects configured interrupt mode</description>
				<value>0</value>
			</interrupt>
			<registers>
				<register>
					<name>DATA_IN</name>
					<description>GPIO Input data read value</description>
					<addressOffset>0x0</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>DIRECT_OUT</name>
					<description>GPIO direct output data write value</description>
					<addressOffset>0x20</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>MASKED_OUT_LOWER</name>
					<description>GPIO write data lower with mask.Masked write for DATA_OUT[15:0].Upper 16 bits of this register are used as mask. Writinglower 16 bits of the register changes DATA_OUT[15:0] valueif mask bits are set.Read-back of this register returns upper 16 bits as zeroand lower 16 bits as DATA_OUT[15:0].</description>
					<addressOffset>0x40</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>data</name>
							<description>Write data value[15:0].Value to write into DATA_OUT[i], valid in the presence of mask[i]==1</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>mask</name>
							<description>Write data mask[15:0].A value of 1 in mask[i] allows the updating of DATA_OUT[i], 0 = i = 15</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>MASKED_OUT_UPPER</name>
					<description>GPIO write data upper with mask.Masked write for DATA_OUT[31:16].Upper 16 bits of this register are used as mask. Writinglower 16 bits of the register changes DATA_OUT[31:16] valueif mask bits are set.Read-back of this register returns upper 16 bits as zeroand lower 16 bits as DATA_OUT[31:16].</description>
					<addressOffset>0x60</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>data</name>
							<description>Write data value[31:16].   Value to write into DATA_OUT[i], valid in the presence of mask[i]==1</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>mask</name>
							<description>Write data mask[31:16].A value of 1 in mask[i] allows the updating of DATA_OUT[i], 16 = i = 31</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>DIRECT_OE</name>
					<description>GPIO Output Enable.Setting direct_oe[i] to 1 enables output mode for GPIO[i]</description>
					<addressOffset>0x80</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>MASKED_OE_LOWER</name>
					<description>GPIO write Output Enable lower with mask.Masked write for DATA_OE[15:0], the register that controlsoutput mode for GPIO pins [15:0].Upper 16 bits of this register are used as mask. Writinglower 16 bits of the register changes DATA_OE[15:0] valueif mask bits are set.Read-back of this register returns upper 16 bits as zeroand lower 16 bits as DATA_OE[15:0].</description>
					<addressOffset>0xa0</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>data</name>
							<description>Write OE value[15:0].Value to write into DATA_OE[i], valid in the presence of mask[i]==1</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>mask</name>
							<description>Write OE mask[15:0].A value of 1 in mask[i] allows the updating of DATA_OE[i], 0 = i = 15</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>MASKED_OE_UPPER</name>
					<description>GPIO write Output Enable upper with mask.Masked write for DATA_OE[31:16], the register that controlsoutput mode for GPIO pins [31:16].Upper 16 bits of this register are used as mask. Writinglower 16 bits of the register changes DATA_OE[31:16] valueif mask bits are set.Read-back of this register returns upper 16 bits as zeroand lower 16 bits as DATA_OE[31:16].</description>
					<addressOffset>0xc0</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>data</name>
							<description>Write OE value[31:16].Value to write into DATA_OE[i], valid in the presence of mask[i]==1</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>mask</name>
							<description>Write OE mask[31:16].A value of 1 in mask[i] allows the updating of DATA_OE[i], 16 = i = 31</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>INTR_CTRL_EN_RISING</name>
					<description>GPIO interrupt enable for GPIO, rising edge.If !!INTR_ENABLE[i] is true, a value of 1 on !!INTR_CTRL_EN_RISING[i]enables rising-edge interrupt detection on GPIO[i].</description>
					<addressOffset>0xe0</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>INTR_CTRL_EN_FALLING</name>
					<description>GPIO interrupt enable for GPIO, falling edge.If !!INTR_ENABLE[i] is true, a value of 1 on !!INTR_CTRL_EN_FALLING[i]enables falling-edge interrupt detection on GPIO[i].</description>
					<addressOffset>0x100</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>INTR_CTRL_EN_LVLHIGH</name>
					<description>GPIO interrupt enable for GPIO, level high.If !!INTR_ENABLE[i] is true, a value of 1 on !!INTR_CTRL_EN_LVLHIGH[i]enables level high interrupt detection on GPIO[i].</description>
					<addressOffset>0x120</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>INTR_CTRL_EN_LVLLOW</name>
					<description>GPIO interrupt enable for GPIO, level low.If !!INTR_ENABLE[i] is true, a value of 1 on !!INTR_CTRL_EN_LVLLOW[i]enables level low interrupt detection on GPIO[i].</description>
					<addressOffset>0x140</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>CTRL_EN_INPUT_FILTER</name>
					<description>filter enable for GPIO input bits.If !!CTRL_EN_INPUT_FILTER[i] is true, a value of input bit [i]must be stable for 16 cycles before transitioning.</description>
					<addressOffset>0x160</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>			</registers>		</peripheral>
		<peripheral>
			<name>i2c0</name>
			<description>I2C interface for host and device mode, supporting up to 1 Mbaud data rates</description>
			<baseAddress>0x40080000</baseAddress>
			<size>32</size>
			<addressBlock>
				<offset>0x40080000</offset>
				<size>576</size>
				<usage>registers</usage>
			</addressBlock>
			<interrupt>
				<name>fmt_threshold</name>
				<description>host mode interrupt: raised when the FMT FIFO depth is less than the low threshold.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>rx_threshold</name>
				<description>host mode interrupt: raised if the RX FIFO is greater than the high threshold.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>fmt_overflow</name>
				<description>host mode interrupt: raised if the FMT FIFO has overflowed.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>rx_overflow</name>
				<description>host mode interrupt: raised if the RX FIFO has overflowed.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>nak</name>
				<description>host mode interrupt: raised if there is no ACK in response to an address or data write</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>scl_interference</name>
				<description>host mode interrupt: raised if the SCL line drops early (not supported without clock synchronization).</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>sda_interference</name>
				<description>host mode interrupt: raised if the SDA line goes low when host is trying to assert high</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>stretch_timeout</name>
				<description>host mode interrupt: raised if target stretches the clock beyond the allowed timeout period</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>sda_unstable</name>
				<description>host mode interrupt: raised if the target does not assert a constant value of SDA during transmission.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>cmd_complete</name>
				<description>host and target mode interrupt.In host mode, raised if the host issues a repated START or terminates the transaction by issuing STOP.In target mode, raised if the external host issues a STOP or repeated START.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>tx_stretch</name>
				<description>target mode interrupt: raised if the target is stretching clocks for a read command.  This is a level status interrupt.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>tx_overflow</name>
				<description>target mode interrupt: raised if TX FIFO has overflowed.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>acq_full</name>
				<description>target mode interrupt: raised if ACQ FIFO becomes full.  This is a level status interrupt.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>unexp_stop</name>
				<description>target mode interrupt: raised if STOP is received without a preceding NACK during an external host read.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>host_timeout</name>
				<description>target mode interrupt: raised if the host stops sending the clock during an ongoing transaction.</description>
				<value>0</value>
			</interrupt>
			<registers>
				<register>
					<name>CTRL</name>
					<description>I2C control register (Functions TBD)</description>
					<addressOffset>0x0</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>ENABLEHOST</name>
							<description>Enable Host I2C functionality</description>
							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>ENABLETARGET</name>
							<description>Enable Target I2C functionality</description>
							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>LLPBK</name>
							<description>Enable I2C line loopback testIf line loopback is enabled, the internal design sees ACQ and RX data as "1"</description>
							<bitRange>[2]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>STATUS</name>
					<description>I2C live status register</description>
					<addressOffset>0x20</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name>FMTFULL</name>
							<description>FMT FIFO is full</description>
							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>RXFULL</name>
							<description>RX FIFO is full</description>
							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>FMTEMPTY</name>
							<description>FMT FIFO is empty</description>
							<bitRange>[2]</bitRange>
						</field>
						<field>
							<name>RXEMPTY</name>
							<description>RX FIFO is empty</description>
							<bitRange>[5]</bitRange>
						</field>
						<field>
							<name>HOSTIDLE</name>
							<description>Host functionality is idle. No Host transaction is in progress</description>
							<bitRange>[3]</bitRange>
						</field>
						<field>
							<name>TARGETIDLE</name>
							<description>Target functionality is idle. No Target transaction is in progress</description>
							<bitRange>[4]</bitRange>
						</field>
						<field>
							<name>TXFULL</name>
							<description>TX FIFO is full</description>
							<bitRange>[6]</bitRange>
						</field>
						<field>
							<name>ACQFULL</name>
							<description>ACQ FIFO is full</description>
							<bitRange>[7]</bitRange>
						</field>
						<field>
							<name>TXEMPTY</name>
							<description>TX FIFO is empty</description>
							<bitRange>[8]</bitRange>
						</field>
						<field>
							<name>ACQEMPTY</name>
							<description>ACQ FIFO is empty</description>
							<bitRange>[9]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>RDATA</name>
					<description>I2C read data</description>
					<addressOffset>0x40</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[7:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>FDATA</name>
					<description>I2C Format Data</description>
					<addressOffset>0x60</addressOffset>
					<size>32</size>
					<access>wo</access>
					<fields>
						<field>
							<name>FBYTE</name>
							<description>Format Byte. Directly transmitted if no flags are set.</description>
							<bitRange>[7:0]</bitRange>
						</field>
						<field>
							<name>START</name>
							<description>Issue a START condition before transmitting BYTE.</description>
							<bitRange>[8]</bitRange>
						</field>
						<field>
							<name>STOP</name>
							<description>Issue a STOP condition after this operation</description>
							<bitRange>[9]</bitRange>
						</field>
						<field>
							<name>READ</name>
							<description>Read BYTE bytes from I2C. (256 if BYTE==0)</description>
							<bitRange>[10]</bitRange>
						</field>
						<field>
							<name>RCONT</name>
							<description>Do not NAK the last byte read, let the read operation continue</description>
							<bitRange>[11]</bitRange>
						</field>
						<field>
							<name>NAKOK</name>
							<description>Do not signal an exception if the current byte is not ACK'd</description>
							<bitRange>[12]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>FIFO_CTRL</name>
					<description>I2C FIFO control register</description>
					<addressOffset>0x80</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>RXRST</name>
							<description>RX fifo reset. Write 1 to the register resets RX_FIFO. Read returns 0</description>
							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>FMTRST</name>
							<description>FMT fifo reset. Write 1 to the register resets FMT_FIFO. Read returns 0</description>
							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>RXILVL</name>
							<description>Trigger level for RX interrupts. If the FIFO depth exceedsthis setting, it raises rx_threshold interrupt.</description>
							<bitRange>[4:2]</bitRange>
							<enumeratedValues>
								<enumeratedValue>
									<name>rxlvl1</name>
									<description>1 character</description>
									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl4</name>
									<description>4 characters</description>
									<value>1</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl8</name>
									<description>8 characters</description>
									<value>2</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl16</name>
									<description>16 characters</description>
									<value>3</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl30</name>
									<description>30 characters</description>
									<value>4</value>
								</enumeratedValue>
							</enumeratedValues>
						</field>
						<field>
							<name>FMTILVL</name>
							<description>Trigger level for FMT interrupts. If the FIFO depth falls belowthis setting, it raises fmt_threshold interrupt.</description>
							<bitRange>[6:5]</bitRange>
							<enumeratedValues>
								<enumeratedValue>
									<name>fmtlvl1</name>
									<description>1 character</description>
									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>fmtlvl4</name>
									<description>4 characters</description>
									<value>1</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>fmtlvl8</name>
									<description>8 characters</description>
									<value>2</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>fmtlvl16</name>
									<description>16 characters</description>
									<value>3</value>
								</enumeratedValue>
							</enumeratedValues>
						</field>
						<field>
							<name>ACQRST</name>
							<description>ACQ FIFO reset. Write 1 to the register resets it. Read returns 0</description>
							<bitRange>[7]</bitRange>
						</field>
						<field>
							<name>TXRST</name>
							<description>TX FIFO reset. Write 1 to the register resets it. Read returns 0</description>
							<bitRange>[8]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>FIFO_STATUS</name>
					<description>I2C FIFO status register</description>
					<addressOffset>0xa0</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name>FMTLVL</name>
							<description>Current fill level of FMT fifo</description>
							<bitRange>[6:0]</bitRange>
						</field>
						<field>
							<name>RXLVL</name>
							<description>Current fill level of RX fifo</description>
							<bitRange>[22:16]</bitRange>
						</field>
						<field>
							<name>TXLVL</name>
							<description>Current fill level of TX fifo</description>
							<bitRange>[14:8]</bitRange>
						</field>
						<field>
							<name>ACQLVL</name>
							<description>Current fill level of ACQ fifo</description>
							<bitRange>[30:24]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>OVRD</name>
					<description>I2C override control register</description>
					<addressOffset>0xc0</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>TXOVRDEN</name>
							<description>Override the SDA and SCL TX signals.</description>
							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>SCLVAL</name>
							<description>Value for SCL Override. Set to 0 to drive TX Low, and set to 1 for high-Z</description>
							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>SDAVAL</name>
							<description>Value for SDA Override. Set to 0 to drive TX Low, and set to 1 for high-Z</description>
							<bitRange>[2]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>VAL</name>
					<description>Oversampled RX values</description>
					<addressOffset>0xe0</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name>SCL_RX</name>
							<description>Last 16 oversampled values of SCL. Most recent bit is bit 0, oldest 15.</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>SDA_RX</name>
							<description>Last 16 oversampled values of SDA. Most recent bit is bit 16, oldest 31.</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>TIMING0</name>
					<description>Detailed I2C Timings (directly corresponding to table 10 in the I2C Specification).All values are expressed in units of the input clock period.</description>
					<addressOffset>0x100</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>THIGH</name>
							<description>The actual time to hold SCL high in a given pulse</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>TLOW</name>
							<description>The actual time to hold SCL low between any two SCL pulses</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>TIMING1</name>
					<description>Detailed I2C Timings (directly corresponding to table 10 in the I2C Specification).All values are expressed in units of the input clock period.</description>
					<addressOffset>0x120</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>T_R</name>
							<description>The nominal rise time to anticipate for the bus (depends on capacitance)</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>T_F</name>
							<description>The nominal fall time to anticipate for the bus (influences SDA hold times)</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>TIMING2</name>
					<description>Detailed I2C Timings (directly corresponding to table 10 in the I2C Specification).All values are expressed in units of the input clock period.</description>
					<addressOffset>0x140</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>TSU_STA</name>
							<description>Actual setup time for repeated start signals</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>THD_STA</name>
							<description>Actual hold time for start signals</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>TIMING3</name>
					<description>Detailed I2C Timings (directly corresponding to table 10, in the I2C Specification).All values are expressed in units of the input clock period.</description>
					<addressOffset>0x160</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>TSU_DAT</name>
							<description>Actual setup time for data (or ack) bits</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>THD_DAT</name>
							<description>Actual hold time for data (or ack) bits(Note, where required, the parameters TVD_DAT is taken to be THD_DAT+T_F)</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>TIMING4</name>
					<description>Detailed I2C Timings (directly corresponding to table 10, in the I2C Specification).All values are expressed in units of the input clock period.</description>
					<addressOffset>0x180</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>TSU_STO</name>
							<description>Actual setup time for stop signals</description>
							<bitRange>[15:0]</bitRange>
						</field>
						<field>
							<name>T_BUF</name>
							<description>Actual time between each STOP signal and the following START signal</description>
							<bitRange>[31:16]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>TIMEOUT_CTRL</name>
					<description>I2C clock stretching timeout control</description>
					<addressOffset>0x1a0</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>VAL</name>
							<description>Clock stretching timeout value (in units of input clock frequency)</description>
							<bitRange>[30:0]</bitRange>
						</field>
						<field>
							<name>EN</name>
							<description>Enable timeout feature</description>
							<bitRange>[31]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>TARGET_ID</name>
					<description>I2C target address and mask pairs</description>
					<addressOffset>0x1c0</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>ADDRESS0</name>
							<description>I2C target address number 0</description>
							<bitRange>[6:0]</bitRange>
						</field>
						<field>
							<name>MASK0</name>
							<description>I2C target mask number 0</description>
							<bitRange>[13:7]</bitRange>
						</field>
						<field>
							<name>ADDRESS1</name>
							<description>I2C target address number 1</description>
							<bitRange>[20:14]</bitRange>
						</field>
						<field>
							<name>MASK1</name>
							<description>I2C target mask number 1</description>
							<bitRange>[27:21]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>ACQDATA</name>
					<description>I2C target acquired data</description>
					<addressOffset>0x1e0</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name>ABYTE</name>
							<description>Address for accepted transaction or acquired byte</description>
							<bitRange>[7:0]</bitRange>
						</field>
						<field>
							<name>SIGNAL</name>
							<description>Host issued a START before transmitting ABYTE, a STOP or a RESTART after the preceeding ABYTE</description>
							<bitRange>[9:8]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>TXDATA</name>
					<description>I2C target transmit data</description>
					<addressOffset>0x200</addressOffset>
					<size>32</size>
					<access>wo</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[7:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>HOST_TIMEOUT_CTRL</name>
					<description>I2C host clock generation timeout value (in units of input clock frequency)</description>
					<addressOffset>0x220</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[31:0]</bitRange>
						</field>
					</fields>
				</register>			</registers>		</peripheral>
		<peripheral>
			<name>i2c1</name>
			<description>I2C interface for host and device mode, supporting up to 1 Mbaud data rates</description>
			<baseAddress>0x40090000</baseAddress>
			<size>32</size>
			<addressBlock>
				<offset>0x40090000</offset>
				<size>576</size>
				<usage>registers</usage>
			</addressBlock>
			<interrupt>
				<name>fmt_threshold</name>
				<description>host mode interrupt: raised when the FMT FIFO depth is less than the low threshold.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>rx_threshold</name>
				<description>host mode interrupt: raised if the RX FIFO is greater than the high threshold.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>fmt_overflow</name>
				<description>host mode interrupt: raised if the FMT FIFO has overflowed.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>rx_overflow</name>
				<description>host mode interrupt: raised if the RX FIFO has overflowed.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>nak</name>
				<description>host mode interrupt: raised if there is no ACK in response to an address or data write</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>scl_interference</name>
				<description>host mode interrupt: raised if the SCL line drops early (not supported without clock synchronization).</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>sda_interference</name>
				<description>host mode interrupt: raised if the SDA line goes low when host is trying to assert high</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>stretch_timeout</name>
				<description>host mode interrupt: raised if target stretches the clock beyond the allowed timeout period</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>sda_unstable</name>
				<description>host mode interrupt: raised if the target does not assert a constant value of SDA during transmission.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>cmd_complete</name>
				<description>host and target mode interrupt.In host mode, raised if the host issues a repated START or terminates the transaction by issuing STOP.In target mode, raised if the external host issues a STOP or repeated START.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>tx_stretch</name>
				<description>target mode interrupt: raised if the target is stretching clocks for a read command.  This is a level status interrupt.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>tx_overflow</name>
				<description>target mode interrupt: raised if TX FIFO has overflowed.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>acq_full</name>
				<description>target mode interrupt: raised if ACQ FIFO becomes full.  This is a level status interrupt.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>unexp_stop</name>
				<description>target mode interrupt: raised if STOP is received without a preceding NACK during an external host read.</description>
				<value>0</value>
			</interrupt>
			<interrupt>
				<name>host_timeout</name>
				<description>target mode interrupt: raised if the host stops sending the clock during an ongoing transaction.</description>
				<value>0</value>
			</interrupt>
			<registers>
				<register>
					<name>CTRL</name>
					<description>I2C control register (Functions TBD)</description>
					<addressOffset>0x0</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>ENABLEHOST</name>
							<description>Enable Host I2C functionality</description>
							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>ENABLETARGET</name>
							<description>Enable Target I2C functionality</description>
							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>LLPBK</name>
							<description>Enable I2C line loopback testIf line loopback is enabled, the internal design sees ACQ and RX data as "1"</description>
							<bitRange>[2]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>STATUS</name>
					<description>I2C live status register</description>
					<addressOffset>0x20</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name>FMTFULL</name>
							<description>FMT FIFO is full</description>
							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>RXFULL</name>
							<description>RX FIFO is full</description>
							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>FMTEMPTY</name>
							<description>FMT FIFO is empty</description>
							<bitRange>[2]</bitRange>
						</field>
						<field>
							<name>RXEMPTY</name>
							<description>RX FIFO is empty</description>
							<bitRange>[5]</bitRange>
						</field>
						<field>
							<name>HOSTIDLE</name>
							<description>Host functionality is idle. No Host transaction is in progress</description>
							<bitRange>[3]</bitRange>
						</field>
						<field>
							<name>TARGETIDLE</name>
							<description>Target functionality is idle. No Target transaction is in progress</description>
							<bitRange>[4]</bitRange>
						</field>
						<field>
							<name>TXFULL</name>
							<description>TX FIFO is full</description>
							<bitRange>[6]</bitRange>
						</field>
						<field>
							<name>ACQFULL</name>
							<description>ACQ FIFO is full</description>
							<bitRange>[7]</bitRange>
						</field>
						<field>
							<name>TXEMPTY</name>
							<description>TX FIFO is empty</description>
							<bitRange>[8]</bitRange>
						</field>
						<field>
							<name>ACQEMPTY</name>
							<description>ACQ FIFO is empty</description>
							<bitRange>[9]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>RDATA</name>
					<description>I2C read data</description>
					<addressOffset>0x40</addressOffset>
					<size>32</size>
					<access>ro</access>
					<fields>
						<field>
							<name></name>
							<bitRange>[7:0]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>FDATA</name>
					<description>I2C Format Data</description>
					<addressOffset>0x60</addressOffset>
					<size>32</size>
					<access>wo</access>
					<fields>
						<field>
							<name>FBYTE</name>
							<description>Format Byte. Directly transmitted if no flags are set.</description>
							<bitRange>[7:0]</bitRange>
						</field>
						<field>
							<name>START</name>
							<description>Issue a START condition before transmitting BYTE.</description>
							<bitRange>[8]</bitRange>
						</field>
						<field>
							<name>STOP</name>
							<description>Issue a STOP condition after this operation</description>
							<bitRange>[9]</bitRange>
						</field>
						<field>
							<name>READ</name>
							<description>Read BYTE bytes from I2C. (256 if BYTE==0)</description>
							<bitRange>[10]</bitRange>
						</field>
						<field>
							<name>RCONT</name>
							<description>Do not NAK the last byte read, let the read operation continue</description>
							<bitRange>[11]</bitRange>
						</field>
						<field>
							<name>NAKOK</name>
							<description>Do not signal an exception if the current byte is not ACK'd</description>
							<bitRange>[12]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>FIFO_CTRL</name>
					<description>I2C FIFO control register</description>
					<addressOffset>0x80</addressOffset>
					<size>32</size>
					<access>rw</access>
					<fields>
						<field>
							<name>RXRST</name>
							<description>RX fifo reset. Write 1 to the register resets RX_FIFO. Read returns 0</description>
							<bitRange>[0]</bitRange>
						</field>
						<field>
							<name>FMTRST</name>
							<description>FMT fifo reset. Write 1 to the register resets FMT_FIFO. Read returns 0</description>
							<bitRange>[1]</bitRange>
						</field>
						<field>
							<name>RXILVL</name>
							<description>Trigger level for RX interrupts. If the FIFO depth exceedsthis setting, it raises rx_threshold interrupt.</description>
							<bitRange>[4:2]</bitRange>
							<enumeratedValues>
								<enumeratedValue>
									<name>rxlvl1</name>
									<description>1 character</description>
									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl4</name>
									<description>4 characters</description>
									<value>1</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl8</name>
									<description>8 characters</description>
									<value>2</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl16</name>
									<description>16 characters</description>
									<value>3</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>rxlvl30</name>
									<description>30 characters</description>
									<value>4</value>
								</enumeratedValue>
							</enumeratedValues>
						</field>
						<field>
							<name>FMTILVL</name>
							<description>Trigger level for FMT interrupts. If the FIFO depth falls belowthis setting, it raises fmt_threshold interrupt.</description>
							<bitRange>[6:5]</bitRange>
							<enumeratedValues>
								<enumeratedValue>
									<name>fmtlvl1</name>
									<description>1 character</description>
									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>fmtlvl4</name>
									<description>4 characters</description>
									<value>1</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>fmtlvl8</name>
									<description>8 characters</description>
									<value>2</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>fmtlvl16</name>
									<description>16 characters</description>
									<value>3</value>
								</enumeratedValue>
							</enumeratedValues>
						</field>
						<field>
							<name>ACQRST</name>
							<description>ACQ FIFO reset. Write 1 to the register resets it. Read returns 0</description>
							<bitRange>[7]</bitRange>
						</field>
						<field>
							<name>TXRST</name>
							<description>TX FIFO reset. Write 1 to the register resets it. Read returns 0</description>
							<bitRange>[8]</bitRange>
						</field>
					</fields>
				</register>
				<register>
					<name>FIFO_STATUS</name>
